# i3 config file for Catppuccin Mocha
# https://i3wm.org/

#############################
## Catppuccin Mocha Colors ##
#############################

# Base
set $rosewater  #f5e0dc
set $flamingo   #f2cdcd
set $pink       #f5c2e7
set $mauve      #cba6f7
set $red        #f38ba8
set $maroon     #eba0ac
set $peach      #fab387
set $yellow     #f9e2af
set $green      #a6e3a1
set $teal       #94e2d5
set $sky        #89dceb
set $sapphire   #74c7ec
set $blue       #89b4fa
set $lavender   #b4befe
set $text       #cdd6f4
set $subtext1   #bac2de
set $subtext0   #a6adc8
set $overlay2   #9399b2
set $overlay1   #7f849c
set $overlay0   #6c7086
set $surface2   #585b70
set $surface1   #45475a
set $surface0   #313244
set $base       #1e1e2e
set $mantle     #181825
set $crust      #11111b

# Focused window colors
client.focused          $surface0 $surface0 $text $blue $blue
client.focused_inactive $surface0 $surface0 $subtext1 $surface0 $surface0
client.unfocused        $surface0 $surface0 $overlay1 $surface0 $surface0
client.urgent           $surface0 $surface0 $red $surface0 $red
client.background       $base

# Window borders and gaps
default_border pixel 2
default_floating_border pixel 2
for_window [class="^.*"] border pixel 2
for_window [class="gsimplecal"] floating enable, border pixel 1
for_window [class="(?i)copyq"] floating enable
gaps inner 8
gaps outer 4

###################
## Startup Programs ##
###################

# External monitor setup (disable internal, use external only), set background,
# then start Polybar (launch.sh is invoked at the end of monitors.sh so the bar
# never binds to an output that is being switched off).
exec_always --no-startup-id ~/.config/i3/monitors.sh
# Compositor
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Audio control daemon
exec --no-startup-id pulseaudio --start

# Cursor setting
exec --no-startup-id xsetroot -cursor_name left_ptr

# NM applet for tray
exec --no-startup-id nm-applet
# Bluetooth applet for tray
exec --no-startup-id blueman-applet &
# Battery check daemon
exec --no-startup-id xset s off
exec --no-startup-id xset -dpms

# Input repeat rate
exec --no-startup-id xset r rate 300 50
# Set keyboard layout (ABNT2 Brazilian Portuguese)
exec --no-startup-id setxkbmap -model abnt2 -layout br
# Enable NumLock on startup and reload
exec_always --no-startup-id numlockx on

# Xsettings and Xresources theme daemons (Dark theme for GTK/Qt/X11)
exec --no-startup-id xrdb -merge ~/.Xresources
exec --no-startup-id xsettingsd &

# Clipboard manager
exec --no-startup-id copyq &
exec --no-startup-id xfce4-clipman &

# Autostart applications
exec --no-startup-id dbus-launch --exit-with-session

#############
## Workspaces ##
#############

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Monitor-specific workspaces (prioritize primary output, external HDMI-1 or internal LVDS-1)
workspace $ws1 output primary HDMI-1 LVDS-1
workspace $ws2 output primary HDMI-1 LVDS-1
workspace $ws3 output primary HDMI-1 LVDS-1
workspace $ws4 output primary HDMI-1 LVDS-1
workspace $ws5 output primary HDMI-1 LVDS-1
workspace $ws6 output primary HDMI-1 LVDS-1
workspace $ws7 output primary HDMI-1 LVDS-1
workspace $ws8 output primary HDMI-1 LVDS-1
workspace $ws9 output primary HDMI-1 LVDS-1

################
## Key Bindings ##
################

# Mod key (Super/Windows key)
set $mod Mod4

# Font for window titles
font pango:JetBrainsMono Nerd Font 10
# Use Mouse+Mod4 (Windows key) right-click to drag floating windows
floating_modifier $mod

# Start a terminal
bindsym $mod+Return exec alacritty

# Kill focused window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Start program launcher (rofi)
bindsym $mod+space exec rofi -show drun -theme slate


# Clipboard manager toggle (CopyQ)
bindsym $mod+c exec --no-startup-id copyq toggle
# Launch KOF 2002 with gamemode (no Steam UI)
bindsym $mod+k exec --no-startup-id ~/.local/bin/kof2002.sh

# Power menu (Desligar / Reiniciar / Encerrar Sessão)
bindsym $mod+0 exec --no-startup-id ~/.local/bin/powermenu.sh
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/powermenu.sh

# Brightness control
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Audio control (Fn volume and mic keys)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/volume.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/volume.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/volume.sh mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.local/bin/volume.sh mic-mute

# Media player control
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioStop exec --no-startup-id playerctl stop
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioNext exec --no-startup-id playerctl next
# Toggle audio output (HDMI / Headphones / Speakers)
bindsym $mod+a exec --no-startup-id ~/.local/bin/audio-toggle.sh

# Screenshot
bindsym Print exec --no-startup-id xfce4-screenshooter -f
bindsym $mod+Print exec --no-startup-id xfce4-screenshooter -r
# Lock screen
bindsym $mod+Shift+Delete exec --no-startup-id i3lock -c $crust

# Reload the file with Postpone Keyboard Binding
bindsym $mod+Shift+r reload


# Change focus (arrow keys to free up hjkl for splits and game)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+h split h
bindsym $mod+v split v

# Toggle fullscreen
bindsym $mod+f fullscreen toggle

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Floating center
bindsym $mod+Shift+c move position center

# Toggle sticky (fixar janela flutuante em todos os workspaces)
bindsym $mod+Shift+s floating enable, sticky toggle

# Atalhos de tamanho pré-definido para janelas (Alt + 1/2/3)
bindsym Mod1+1 resize set 480 270
bindsym Mod1+2 resize set 800 600
bindsym Mod1+3 resize set 1280 720

# Focus between tiling and floating

# Move workspace to output
bindsym $mod+Shift+greater move container to output right
bindsym $mod+Shift+less move container to output left
# Workspace switching
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9

# Mover janela e acompanhar para outro workspace
bindsym $mod+Ctrl+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Ctrl+9 move container to workspace $ws9; workspace $ws9

# Window resize mode
mode "resize" {
    bindsym j resize e 20 px or 20 ppt
    bindsym k resize s 20 px or 20 ppt
    bindsym l resize w 20 px or 20 ppt
    bindsym semicolon resize e 20 px or 20 ppt

    # Exit resize mode
    bindsym Escape mode "default"
    bindsym Return mode "default"

    # Exit resize mode (with mod key)
    bindsym $mod+Escape mode "default"
}

bindsym $mod+r mode "resize"

################
## Bar Settings ##
################

# Polybar is used instead of i3bar for flexible tray positioning (tray at start of info blocks)
# Launched in Startup Programs via ~/.config/polybar/launch.sh

# Always start on workspace 1
exec --no-startup-id i3-msg 'workspace 1'
